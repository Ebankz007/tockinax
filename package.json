{
  "name": "tockinax",
  "version": "0.1.0",
  "private": true,
  "description": "TOCKINAX — gated P2P community marketplace + referral + rewards (modular monolith)",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "test": "npm run test --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "docker:up": "docker compose up -d db redis",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": { "node": ">=20" }
}
