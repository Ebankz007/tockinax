{
  "name": "tockinax-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.cjs",
    "db:migrate:payments": "node db/migrate-payments.cjs",
    "db:migrate:all": "node db/migrate.cjs && node db/migrate-payments.cjs",
    "db:seed": "node db/seed.cjs",
    "db:seed:payments": "node db/seed-payments.cjs",
    "db:studio": "drizzle-kit studio",
    "test": "jest --runInBand",
    "test:live": "node live-smoke.cjs",
    "sweeper": "node src/workers/sweeper.cjs",
    "sweeper:once": "node src/workers/sweeper.cjs --once",
    "admin:create": "node src/scripts/admin-create.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.12.0",
    "speakeasy": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.24.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
