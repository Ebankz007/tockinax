# tockinax — PROD env template (PLACEHOLDERS ONLY — never commit real secrets)
NODE_ENV=production
PORT=5070
APP_URL=https://tockinax.com
API_URL=https://api.tockinax.com/api/v1
PLATFORM_NAME=TOCKINAX
COMPANY_NAME=MMITPS INC
WEBSITE_DOMAIN=tockinax.com

# Prod Postgres (own database recommended; schema gatedp2p via ?options=--search_path%3Dgatedp2p)
DATABASE_URL=postgresql://USER:CHANGE_ME@127.0.0.1:5432/tockinax_prod?options=--search_path%3Dgatedp2p
REDIS_URL=redis://127.0.0.1:6379

# Auth (openssl rand -base64 64 / openssl rand -hex 32) — REQUIRED, no defaults
JWT_SECRET=CHANGE_ME_88_CHAR_BASE64
JWT_REFRESH_SECRET=CHANGE_ME_88_CHAR_BASE64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=CHANGE_ME_64_HEX

# Mail/storage (leave blank until approved providers exist; app stubs safely)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@tockinax.com
STORAGE_DRIVER=local
STORAGE_DIR=./backend/uploads-private

# Payments — BLANK until COMPLIANCE sign-off (see docs/GATE_PROPOSAL.md)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
KORAPAY_SECRET_KEY=
KORAPAY_WEBHOOK_SECRET=

# Gates — all false until Henry signs each row in docs/GATE_PROPOSAL.md
LIVE_PAYMENTS_ENABLED=false
CRYPTO_PAYOUTS_ENABLED=false
CRYPTO_DEPOSITS_ENABLED=false
REWARDS_PAYOUTS_ENABLED=false

# Ops
PAYOUT_DUAL_APPROVAL_THRESHOLD_NGN=500000
DEFAULT_CURRENCY=USD
ALLOWED_CURRENCIES=USD,NGN
FX_PROVIDER=manual
ADMIN_BOOTSTRAP_TOKEN_TTL_MIN=60
PGDUMP=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
BACKUP_DIR=C:\Backups\tockinax

# Pay2Crypto USDT gateway (sandbox-first; LIVE STAYS OFF)
# Settlement address is configured OUT-OF-BAND with the provider — never in repo.
# Live stays OFF until: API token + webhook secret issued, settlement-address
# approval recorded, legal sign-off, and feature flag live_payments enabled.
PAY2CRYPTO_BASE_URL=https://api.pay2crypto.com/v1/
PAY2CRYPTO_API_TOKEN=
PAY2CRYPTO_WEBHOOK_SECRET=
PAY2CRYPTO_NETWORK=TRC20
PAY2CRYPTO_SANDBOX=true
