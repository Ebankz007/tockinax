# tockinax — env template (PLACEHOLDERS ONLY — never commit real secrets)
NODE_ENV=development
PORT=5070
APP_URL=http://localhost:3001
API_URL=http://localhost:5070/api/v1
PLATFORM_NAME=TOCKINAX
COMPANY_NAME=MMITPS INC
WEBSITE_DOMAIN=tockinax.com

# PostgreSQL (docker-compose service `db`)
DATABASE_URL=postgresql://tockinax_user:CHANGE_ME_DEV_ONLY@localhost:5434/tockinax_dev

# Redis (docker-compose service `redis`)
REDIS_URL=redis://localhost:6380

# Auth (generate: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_88_CHAR_BASE64
JWT_REFRESH_SECRET=CHANGE_ME_88_CHAR_BASE64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=CHANGE_ME_64_HEX__openssl_rand_-hex_32

# Mail (transactional; dev logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@TBD

# Storage (dev=local disk; prod=S3-compatible)
STORAGE_DRIVER=local
STORAGE_DIR=./backend/uploads-private
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payments — DISABLED until live approval (leave blank in dev)
# When blank, providers run in stub/sandbox-verify mode and live_payments stays false.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
KORAPAY_SECRET_KEY=
KORAPAY_WEBHOOK_SECRET=

# Feature gates (secure defaults — do NOT enable without approvals per COMPLIANCE_CHECKLIST)
LIVE_PAYMENTS_ENABLED=false
CRYPTO_PAYOUTS_ENABLED=false
CRYPTO_DEPOSITS_ENABLED=false
REWARDS_PAYOUTS_ENABLED=false

# Ops
PAYOUT_DUAL_APPROVAL_THRESHOLD_NGN=500000
DEFAULT_CURRENCY=USD
ALLOWED_CURRENCIES=USD,NGN
FX_PROVIDER=manual
ADMIN_BOOTSTRAP_TOKEN_TTL_MIN=60

# Pay2Crypto USDT gateway (sandbox-first; LIVE STAYS OFF)
# Settlement address is configured OUT-OF-BAND with the provider — never in repo.
# Live stays OFF until: API token + webhook secret issued, settlement-address
# approval recorded, legal sign-off, and feature flag live_payments enabled.
PAY2CRYPTO_BASE_URL=https://api.pay2crypto.com/v1/
PAY2CRYPTO_API_TOKEN=
PAY2CRYPTO_WEBHOOK_SECRET=
PAY2CRYPTO_NETWORK=TRC20
PAY2CRYPTO_SANDBOX=true
